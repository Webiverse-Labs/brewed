# Port the Express server listens on. The frontend expects 4000 (see frontend/src/lib/api.js).
PORT=4000

# MongoDB connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/brewed
MONGO_URI=

# Secret used to sign JWTs. Use your own random value; never reuse this across environments.
JWT_SECRET=

# Frontend origin allowed by CORS (Vite dev server).
CLIENT_URL=http://localhost:5173

# Password given to every account created by `npm run seed` (including admin@brewed.app).
# Pick any local test value; it is never committed.
SEED_PASSWORD=

# Email (verification + password reset) goes out through the team Gmail account over SMTP.
# GMAIL_APP_PASSWORD is a Google "app password" (Google Account → Security → App passwords), not the login password.
# Leave the GMAIL_* values empty locally: emails are printed in the server log instead of being sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Shown as the sender, e.g. Brewed <team@gmail.com>. Defaults to GMAIL_USER.
EMAIL_FROM=
# Public OAuth Client ID for "Sign in with Google" (Google Cloud Console → APIs & Services → Credentials). Not a secret.
# The backend checks that every Google ID token was issued for this ID. The frontend needs the same value as
# VITE_GOOGLE_CLIENT_ID (see frontend/.env.example). Leave empty to turn Google sign-in off (the endpoint answers 503).
GOOGLE_CLIENT_ID=

# CLIENT_URL (above) also builds the links in these emails, so on the deploy it must be the public site URL.
