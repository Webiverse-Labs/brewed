# Frontend dev settings. Copy to .env.local (git-ignored); the values are read when `npm run dev` starts.

# Where the API is. Defaults to http://localhost:4000 in dev (production uses the same origin).
# VITE_API_URL=http://localhost:4100

# Public OAuth Client ID for "Sign in with Google" (Google Cloud Console → APIs & Services → Credentials).
# It's not a secret. Leave it unset to hide the Google button. The backend needs the same value as GOOGLE_CLIENT_ID.
# The page's origin (e.g. http://localhost:5173) must be listed under the client's Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
